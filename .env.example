# Endereço interno do processo. Em Docker, mantenha 0.0.0.0.
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
PUBLIC_DIR=/app/public

# Limites em bytes. Ajuste apenas após medir o volume real.
MAX_BODY_BYTES=20971520
MAX_STORE_BYTES=52428800

# Metadado de execução; não contém segredo.
NODE_ENV=production

# Porta publicada apenas em 127.0.0.1 pelo Docker Compose.
TCCON_PORT=3000

# Limites operacionais do container.
TCCON_MEMORY_LIMIT=512m
TCCON_CPU_LIMIT=1.0
TCCON_LOG_MAX_SIZE=10m
TCCON_LOG_MAX_FILES=5
