# Endereço interno do processo. Em Docker, mantenha 0.0.0.0.
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
PUBLIC_DIR=/app/public

# Limites em bytes. Ajuste apenas após medir o volume real.
MAX_BODY_BYTES=20971520
MAX_STORE_BYTES=52428800

# Metadado de execução; não contém segredo.
NODE_ENV=production

# Domínio público, sem https:// e sem caminho. Também limita o Host aceito.
TCCON_DOMAIN=orcamentos.seudominio.com.br

# Como o Traefik está em outra VPS, publique no IP alcançável por ele.
# Use o IP privado/VPN quando existir; 0.0.0.0 exige firewall por IP de origem.
TCCON_BIND_IP=0.0.0.0
TCCON_PORT=3000

# URL usada para gerar a configuração dinâmica na VPS do Traefik.
# Troque pelo IP privado/VPN da VPS da aplicação.
TCCON_BACKEND_URL=http://10.0.0.20:3000

# Nomes definidos na configuração estática da VPS do Traefik.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_AUTH_USERS_FILE=/etc/traefik/tccon-users

# Limites operacionais do container.
TCCON_MEMORY_LIMIT=512m
TCCON_CPU_LIMIT=1.0
TCCON_LOG_MAX_SIZE=10m
TCCON_LOG_MAX_FILES=5
